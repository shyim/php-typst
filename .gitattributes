# Keep Composer dist packages (vendor/shyim/php-typst) lean: only runtime sources.
# Composer uses `git archive` / GitHub zipballs, which honour export-ignore.

/.github/           export-ignore
/tests/             export-ignore
/examples/          export-ignore
/bin/               export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpunit.xml.dist   export-ignore
/phpstan.neon.dist  export-ignore
/composer.lock      export-ignore

# Normalize line endings for text sources in the package.
* text=auto eol=lf
*.php text eol=lf
*.json text eol=lf
*.md text eol=lf
*.typ text eol=lf
*.cdef text eol=lf
*.h text eol=lf
